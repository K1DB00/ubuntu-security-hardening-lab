# ============================================================
# Security Hardening Lab - Audit Rules
# ============================================================

# Identity and account management
-w /etc/passwd -p wa -k identity_changes
-w /etc/group -p wa -k identity_changes
-w /etc/shadow -p wa -k identity_changes
-w /etc/gshadow -p wa -k identity_changes

# Privilege configuration
-w /etc/sudoers -p wa -k privilege_changes
-w /etc/sudoers.d/ -p wa -k privilege_changes

# SSH configuration
-w /etc/ssh/sshd_config -p wa -k ssh_config_changes
-w /etc/ssh/sshd_config.d/ -p wa -k ssh_config_changes

# Secure logging / mTLS configuration
-w /etc/rsyslog.conf -p wa -k logging_changes
-w /etc/rsyslog.d/ -p wa -k logging_changes
-w /etc/rsyslog/ssl/ -p wa -k logging_changes

# AppArmor configuration
-w /etc/apparmor.d/ -p wa -k apparmor_changes

# Audit subsystem configuration
-w /etc/audit/ -p wa -k audit_config_changes

# Privileged command execution
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid>=1000 -F auid!=4294967295 -k privileged_commands

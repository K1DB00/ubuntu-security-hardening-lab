# --- Credentials / secrets ---
*.env
.env.*
secrets/
secrets.*
credentials
credentials.*
*.secret
*.token
*_password*
*.htpasswd

# --- Logs ---
*.log
logs/
*.log.*
*.journal

# --- Generated audit / report output ---
*audit-report*
*-report.txt
*-report.json
*-report.html
reports/

# --- Backup archives ---
*.bak
*.backup
*.tar
*.tar.gz
*.tgz
*.zip
*.7z


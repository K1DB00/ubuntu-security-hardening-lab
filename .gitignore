*.swp
*.swo
*~
.vscode/
.idea/

# --- Lab-specific SSH private key protection ---
adminsec_sec_server
.ssh/
**/.ssh/

# --- Explicit allowlist (do not ignore) ---
!*.pub
!*.md
!*.png
!*.jpg
!*.jpeg
